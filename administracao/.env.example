# ============================================================================
# AgendeAqui - Environment Variables Template
# ============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Preencha os valores reais (NUNCA commite o .env no Git)
# 3. Adicione .env ao .gitignore
# ============================================================================

# ============================
# Django Core Settings
# ============================
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-with-django-get-random-secret-key

# Ambientes: development, staging, production
ENVIRONMENT=development

# ============================
# Security & Hosts
# ============================
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ============================
# Database (PostgreSQL)
# ============================
DATABASE_URL=postgresql://user:password@localhost:5432/agendeaqui
# Ou configuração separada:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=agendeaqui
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_HOST=localhost
DB_PORT=5432

# ============================
# Email Configuration
# ============================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu.email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_app
DEFAULT_FROM_EMAIL=noreply@agendeaqui.com

# Email alternativo (AWS SES):
# EMAIL_BACKEND=django_ses.SESBackend
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_SES_REGION_NAME=us-east-1
# AWS_SES_REGION_ENDPOINT=email.us-east-1.amazonaws.com

# ============================
# Redis & Cache
# ============================
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1

# ============================
# Celery (Task Queue)
# ============================
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ============================
# Static & Media Files
# ============================
STATIC_ROOT=/var/www/agendeaqui/static
MEDIA_ROOT=/var/www/agendeaqui/media
STATIC_URL=/static/
MEDIA_URL=/media/

# Cloud Storage (AWS S3 - opcional)
# USE_S3=False
# AWS_STORAGE_BUCKET_NAME=agendeaqui-media
# AWS_S3_REGION_NAME=us-east-1

# ============================
# Monitoring & Logging
# ============================
# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================
# Security Headers
# ============================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# ============================
# Rate Limiting
# ============================
RATELIMIT_ENABLE=True
RATELIMIT_VIEW=100/h  # 100 requests per hour per view

# ============================
# Custom App Settings
# ============================
# Horário de funcionamento da instituição
INSTITUTION_OPEN_TIME=07:00
INSTITUTION_CLOSE_TIME=22:00

# Dias da semana permitidos (0=Segunda, 6=Domingo)
ALLOWED_WEEKDAYS=0,1,2,3,4,5  # Segunda a Sábado

# Antecedência mínima para agendamentos (em horas)
MIN_BOOKING_ADVANCE_HOURS=2

# Antecedência máxima para agendamentos (em dias)
MAX_BOOKING_ADVANCE_DAYS=30

# Tempo mínimo de cancelamento (em horas)
MIN_CANCELLATION_HOURS=24

# Limite de agendamentos por usuário por período
MAX_BOOKINGS_PER_USER_PER_WEEK=5

# ============================
# Third-party APIs (Opcional)
# ============================
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
